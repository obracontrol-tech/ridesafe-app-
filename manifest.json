{
  "name": "RideSafe IA",
  "short_name": "RideSafe IA",
  "description": "La app gratis para salir en bici con tu club: salidas, rutas, pelotón en vivo y avisos de seguridad.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E1A2B",
  "theme_color": "#0E1A2B",
  "lang": "es",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-gpx",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "gpx",
          "accept": [
            ".gpx",
            ".tcx",
            "application/gpx+xml",
            "application/vnd.garmin.tcx+xml",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html?gpx=open",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.garmin.tcx+xml": [
          ".tcx"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "QR RideSafe IA",
      "short_name": "QR RideSafe",
      "description": "Enseña el código QR para que escaneen la app",
      "url": "./qr.html",
      "icons": [
        {
          "src": "icons/qr-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}